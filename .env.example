# Copiar a .env.local (ignorado por git) y completar.
# .env.local apunta al proyecto Supabase de DESARROLLO (finance-dev).
# Las credenciales de producción (finance) viven solo en las variables de entorno de Vercel.

NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_…): pública por diseño; la protege RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (sb_secret_…): nunca exponer al cliente ni prefijar con NEXT_PUBLIC_.
# Se copia de Project Settings > API Keys o con `pnpm supabase projects api-keys`.
SUPABASE_SECRET_KEY=

# Protege /api/cron/*: el cron envía "Authorization: Bearer ${CRON_SECRET}". Generar con
# `openssl rand -hex 32`; con menos de 32 caracteres el endpoint queda cerrado (falla cerrado).
CRON_SECRET=

# yahoo | finnhub | twelvedata (por ahora solo yahoo está implementado)
MARKET_DATA_PROVIDER=yahoo
# Opcional (proveedor alternativo)
FINNHUB_API_KEY=

APP_TIMEZONE=America/Montevideo

# Asistente (solo servidor). Sin OPENROUTER_API_KEY la pestaña muestra "no disponible".
# Los modelos son ids de OpenRouter con soporte de tools (p. ej. los `:free`). Respaldo: hasta 2 ids
# separados por comas, que OpenRouter prueba en orden si el principal falla o llega a su límite.
OPENROUTER_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_FALLBACK_MODEL=
# Opcional: sin esta clave el asistente no busca noticias.
TAVILY_API_KEY=

# La lista de emails con acceso vive en la tabla public.allowed_emails (ver docs/supabase-setup.md).
